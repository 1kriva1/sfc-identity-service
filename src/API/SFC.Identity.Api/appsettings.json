  "Redis": {
    "User": "sfc",
    "Password": "Test1234!",
    "InstanceName": "SFC.Identity"
  },
  "RabbitMq": {
    "Username": "sfc",
    "Password": "Test1234!",
    "Name": "SFC.Identity",
    "Retry": {
      "Limit": 5,
      "Intervals": [ 1, 5, 10 ]
    },
    "Exchanges": {
      "Identity": {
        "Key": "identity",
        "Value": {
          "Domain": {
            "User": {
              "Events": {
                "Created": {
                  "Name": "sfc.identity.user.created",
                  "Type": "fanout"
                }
              },
              "Seed": {
                "Seeded": {
                  "Name": "sfc.identity.users.seeded",
                  "Type": "fanout"
                },
                "Seed": {
                  "Name": "sfc.identity.users.seed",
                  "Type": "direct"
                },
                "RequireSeed": {
                  "Name": "sfc.identity.users.seed.require"
                }
              }
            }
          }
        }
      }
    }
  },
  "Grpc": {
    "MaxReceiveMessageSizeInMb": 2,
    "MaxSendMessageSizeInMb": 4
  }
