{
  "ConnectionStrings": {
    "Database": "Server=sfc-mssql,1433;Database=Identity;User Id=sfc;Password=Test1234!;TrustServerCertificate=True;",
    "RabbitMq": "rabbitmq://sfc-rabbitmq:5672",
    "Redis": "sfc-redis:6379"
