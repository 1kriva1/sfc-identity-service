  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:7265",
        "Protocols": "Http1"
      },
      "Https&Grpc": {
        "Url": "https://+:7266",
        "Protocols": "Http1AndHttp2"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "/https/sfc-identity.pfx",
        "Password": "Test1234!"
      }
    }
  },
  "Identity": {
    // for local grpc api
    "Authentication": {
      "Authority": "https://sfc-identity",
      "Audience": "sfc.identity",
      "RequireClaims": {
        "scope": [ "sfc.identity.full" ]
      }
    },
    "Clients": [
      {
        "Id": "sfc",
        "Name": "Street Football Club",
        "Secrets": [ "secret_sfc" ],
        "AllowedGrantTypes": [ "authorization_code" ],
        "AllowOfflineAccess": true,
        "UpdateAccessTokenClaimsOnRefresh": true,
        "RedirectUris": [ "https://sfc-bff/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://sfc-bff/signout-callback-oidc" ],
        "Scopes": [ "openid", "profile", "test_scope" ],
        "AccessTokenLifetime": 3600,
        "IdentityTokenLifetime": 300,
        "AbsoluteRefreshTokenLifetime": 2592000,
        "SlidingRefreshTokenLifetime": 1296000
      },
      {
        "Id": "sfc.identity",
        "Name": "SFC Identity API Exchange Token Client",
        "Secrets": [ "secret_sfc_identity" ],
        "AllowedGrantTypes": [ "urn:ietf:params:oauth:grant-type:token-exchange" ],
